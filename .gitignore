# This .gitignore file should be placed at the root of Unity project directory
#

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/

# MemoryCaptures can get huge.
[Mm]emoryCaptures/

# Recordings can get huge
[Rr]ecordings/

# Autogenerated Visual Studio and JetBrains Rider files
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity Generated Metal/Shader cache
[Cc]acheServer/
[Ll]ocal[Cc]ache/
[Tt]est[Rr]esults/

# Autogenerated code coverage and profiler files
[Cc]ode[Cc]overage/
[Pp]rofiler/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
